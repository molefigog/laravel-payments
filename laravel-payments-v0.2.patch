+  IDLE: 'idle',
+  CHARGING: 'charging',
+  OTP: 'otp',
+  POLLING: 'polling',
+  REDIRECTING: 'redirecting',
+  HTML: 'html',
+  SUCCESS: 'success',
+  FAILED: 'failed',
+  TIMEOUT: 'timeout',
+});
