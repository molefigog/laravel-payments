+      - name: Syntax check
+        run: find src config database routes -name '*.php' -print0 | xargs -0 -n1 php -l
+      - name: Pure-logic checks
+        run: php tests/smoke.php
+      - name: Installer building blocks and stubs
+        run: php tests/publisher.php
+
+  js:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - run: npm test
+      - name: Global bundle is up to date
+        run: |
+          npm run build
+          git diff --exit-code resources/dist
