/**
 * Looks products up on the SERVER, so a client can never choose its own price.
 * Registered in config/payments.php ('resolver'). Returning no products makes every charge fail safely
 * until you implement this.
 */
class AppProductResolver implements ProductResolver
{
    public function resolve(array $productIds, array $context = []): array
    {
