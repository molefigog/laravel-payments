{
    "name": "molefigog/laravel-payments",
    "description": "Multi-gateway payments for Laravel (M-Pesa Lesotho, EcoCash, Chaperone CPay, PayPal) behind one API: product-based charges, events, DB-managed gateways.",
    "keywords": ["laravel", "payments", "mpesa", "ecocash", "cpay", "paypal", "lesotho"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Molefigog\\Payments\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Molefigog\\Payments\\PaymentsServiceProvider"
            ],
            "aliases": {
                "Payments": "Molefigog\\Payments\\Facades\\Payments"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
